{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/ritmo/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/babymarley", "destination": "/ritmo/babymarley.html" },
    { "source": "/babymarley/", "destination": "/ritmo/babymarley.html" },
    { "source": "/sobre", "destination": "/ritmo/sobre.html" },
    { "source": "/sobre.html", "destination": "/ritmo/sobre.html" },
    { "source": "/privacy", "destination": "/ritmo/privacy.html" },
    { "source": "/privacy.html", "destination": "/ritmo/privacy.html" },
    { "source": "/terms", "destination": "/ritmo/terms.html" },
    { "source": "/terms.html", "destination": "/ritmo/terms.html" },
    { "source": "/ritmo", "destination": "/ritmo/index.html" },
    { "source": "/ritmo/(.*)", "destination": "/ritmo/index.html" }
  ]
}
